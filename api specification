openapi: 3.0.3
info:
  title: CAB System API - FR06 to FR29
  description: >
    Đặc tả OpenAPI cho các yêu cầu chức năng FR06-FR29 của dự án CAB System
    (Nền tảng đặt xe). Mỗi operation có phần mở rộng `x-functional-requirement`
    ghi rõ FR tương ứng để phục vụ truy xuất nguồn gốc (traceability - B14).
    Đây là bản nháp phục vụ giai đoạn thiết kế/thảo luận, một số trường (đặc
    biệt trong nhóm thanh toán và matching) còn phụ thuộc vào các "open items"
    chưa được khách hàng chốt (xem tài liệu phân tích nghiệp vụ, mục B8).
  version: "1.0.0"
  contact:
    name: Business Analyst Team

servers:
  - url: https://api.cabsystem.example.com/v1
    description: Production server (placeholder)

tags:
  - name: DriverOffers
    description: FR06-FR07 - Tìm/phân công tài xế, xử lý từ chối/timeout
  - name: TripTracking
    description: FR08-FR09 - Theo dõi trạng thái chuyến đi, vị trí, ETA
  - name: Drivers
    description: FR10-FR14 - Hồ sơ, phương tiện, trạng thái, vị trí, cập nhật chuyến của tài xế
  - name: Payments
    description: FR15-FR18 - Tính cước và thanh toán
  - name: Notifications
    description: FR19-FR20 - Thông báo cho khách hàng và tài xế
  - name: Admin
    description: FR21-FR24 - Quản trị vận hành, xử lý sự cố, tra cứu, phân quyền
  - name: Reports
    description: FR25 - Báo cáo thống kê
  - name: Customers
    description: FR26-FR27 - Lịch sử chuyến, thanh toán, đánh giá tài xế
  - name: Auth
    description: FR28 - Xác thực khách hàng/tài xế
  - name: Audit
    description: FR29 - Ghi log audit trail

paths:
  # ===================== FR06 - FR07: DRIVER OFFERS =====================
  /trips/{tripId}/driver-offers:
    get:
      tags: [DriverOffers]
      summary: Xem lịch sử các đề xuất chuyến đi đã gửi cho một chuyến
      x-functional-requirement: FR06
      description: >
        Trả về danh sách các đề xuất (driver offers) đã gửi cho một chuyến,
        bao gồm cả các đề xuất bị từ chối/timeout - phục vụ theo dõi cơ chế
        tự động chuyển tài xế kế tiếp.
      parameters:
        - $ref: '#/components/parameters/TripId'
      responses:
        '200':
          description: Danh sách đề xuất chuyến đi
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/DriverOffer'
        '404':
          $ref: '#/components/responses/NotFound'

  /trips/{tripId}/driver-offers/{offerId}/respond:
    post:
      tags: [DriverOffers]
      summary: Tài xế phản hồi một đề xuất chuyến đi
      x-functional-requirement: FR06
      description: >
        Tài xế chấp nhận hoặc từ chối đề xuất. Nếu từ chối, hệ thống tự động
        tạo đề xuất mới cho tài xế kế tiếp (nextOffer) hoặc trả về
        tripStatus=no_driver_found nếu hết tài xế phù hợp (kích hoạt FR07).
      parameters:
        - $ref: '#/components/parameters/TripId'
        - $ref: '#/components/parameters/OfferId'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/DriverOfferResponseRequest'
      responses:
        '200':
          description: Ghi nhận phản hồi thành công
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/DriverOfferResponseResult'
        '400':
          $ref: '#/components/responses/BadRequest'
        '404':
          $ref: '#/components/responses/NotFound'
        '409':
          description: Đề xuất đã hết hạn hoặc đã được xử lý
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

  /trips/{tripId}/no-driver-notification:
    get:
      tags: [DriverOffers]
      summary: Lấy thông tin thông báo "không tìm được tài xế" của một chuyến
      x-functional-requirement: FR07
      description: >
        Trả về chi tiết thông báo hiển thị cho khách hàng khi hệ thống không
        còn tài xế phù hợp nào sau khi đã thử hết danh sách ứng viên.
      parameters:
        - $ref: '#/components/parameters/TripId'
      responses:
        '200':
          description: Thông báo không tìm được tài xế
          content:
            application/json:
              schema:
                type: object
                properties:
                  tripId:
                    type: string
                  status:
                    type: string
                    enum: [no_driver_found]
                  message:
                    type: string
                    example: "Hiện không tìm thấy tài xế phù hợp. Vui lòng thử lại sau."
                  triedOfferCount:
                    type: integer
                    example: 5
                  canRetry:
                    type: boolean
                    example: true
        '404':
          $ref: '#/components/responses/NotFound'

  # ===================== FR08 - FR09: TRIP TRACKING =====================
  /trips/{tripId}/status:
    get:
      tags: [TripTracking]
      summary: Xem trạng thái chuyến đi theo thời gian thực
      x-functional-requirement: FR08
      description: >
        Trả về trạng thái hiện tại của chuyến đi (đang tìm tài xế, đã nhận,
        đến điểm đón, đang di chuyển, hoàn thành...). Client có thể poll định
        kỳ endpoint này, hoặc dùng kênh realtime khác nếu hệ thống hỗ trợ
        (WebSocket/SSE - chưa nằm trong phạm vi đặc tả REST này).
      parameters:
        - $ref: '#/components/parameters/TripId'
      responses:
        '200':
          description: Trạng thái chuyến đi hiện tại
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TripStatus'
        '404':
          $ref: '#/components/responses/NotFound'

  /trips/{tripId}/driver-eta:
    get:
      tags: [TripTracking]
      summary: Xem vị trí tài xế hiện tại và thời gian dự kiến đến (ETA)
      x-functional-requirement: FR09
      parameters:
        - $ref: '#/components/parameters/TripId'
      responses:
        '200':
          description: Vị trí và ETA của tài xế được gán cho chuyến
          content:
            application/json:
              schema:
                type: object
                properties:
                  tripId:
                    type: string
                  driverId:
                    type: string
                  driverLocation:
                    $ref: '#/components/schemas/GeoLocation'
                  etaSeconds:
                    type: integer
                    description: Thời gian dự kiến tài xế đến điểm đón/điểm đến (giây)
                    example: 240
                  updatedAt:
                    type: string
                    format: date-time
        '404':
          $ref: '#/components/responses/NotFound'

  # ===================== FR10 - FR14: DRIVERS =====================
  /drivers:
    post:
      tags: [Drivers]
      summary: Tài xế đăng ký tài khoản / nhân viên vận hành tạo tài khoản tài xế
      x-functional-requirement: FR10
      description: >
        Trường `createdBy` xác định nguồn tạo tài khoản: 'self' (tài xế tự
        đăng ký) hoặc 'operator' (nhân viên vận hành tạo hộ).
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/DriverCreateRequest'
      responses:
        '201':
          description: Tài khoản tài xế được tạo thành công
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Driver'
        '400':
          $ref: '#/components/responses/BadRequest'

  /drivers/{driverId}:
    put:
      tags: [Drivers]
      summary: Tài xế cập nhật hồ sơ cá nhân
      x-functional-requirement: FR11
      parameters:
        - $ref: '#/components/parameters/DriverId'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/DriverProfileUpdateRequest'
      responses:
        '200':
          description: Hồ sơ được cập nhật
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Driver'
        '404':
          $ref: '#/components/responses/NotFound'

  /drivers/{driverId}/vehicle:
    put:
      tags: [Drivers]
      summary: Tài xế cập nhật thông tin phương tiện
      x-functional-requirement: FR11
      parameters:
        - $ref: '#/components/parameters/DriverId'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Vehicle'
      responses:
        '200':
          description: Thông tin phương tiện được cập nhật
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Vehicle'
        '404':
          $ref: '#/components/responses/NotFound'

  /drivers/{driverId}/status:
    patch:
      tags: [Drivers]
      summary: Tài xế chuyển trạng thái hoạt động
      x-functional-requirement: FR12
      description: Chuyển đổi giữa các trạng thái sẵn sàng/bận/offline.
      parameters:
        - $ref: '#/components/parameters/DriverId'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                status:
                  $ref: '#/components/schemas/DriverStatus'
              required: [status]
      responses:
        '200':
          description: Trạng thái tài xế đã được cập nhật
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Driver'
        '404':
          $ref: '#/components/responses/NotFound'

  /drivers/{driverId}/location:
    post:
      tags: [Drivers]
      summary: Ghi nhận vị trí tài xế theo thời gian thực
      x-functional-requirement: FR13
      description: >
        Client (app tài xế) gửi định kỳ vị trí GPS hiện tại lên hệ thống để
        phục vụ matching và hiển thị ETA cho khách hàng.
      parameters:
        - $ref: '#/components/parameters/DriverId'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/GeoLocation'
      responses:
        '204':
          description: Vị trí được ghi nhận thành công (không có nội dung trả về)
        '404':
          $ref: '#/components/responses/NotFound'

  /trips/{tripId}/driver-status:
    patch:
      tags: [Drivers]
      summary: Tài xế cập nhật trạng thái chuyến đi
      x-functional-requirement: FR14
      description: >
        Tài xế cập nhật các mốc trạng thái trong lúc thực hiện chuyến: đã đến
        điểm đón, đã đón khách, đang di chuyển, hoàn thành chuyến.
      parameters:
        - $ref: '#/components/parameters/TripId'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                status:
                  type: string
                  enum: [arrived_at_pickup, picked_up, in_progress, completed]
              required: [status]
      responses:
        '200':
          description: Trạng thái chuyến được cập nhật
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TripStatus'
        '404':
          $ref: '#/components/responses/NotFound'

  # ===================== FR15 - FR18: PAYMENTS =====================
  /trips/{tripId}/fare:
    get:
      tags: [Payments]
      summary: Tính cước chuyến đi
      x-functional-requirement: FR15
      description: >
        Tính số tiền phải trả dựa trên loại dịch vụ và dữ liệu chuyến đi
        (quãng đường, thời gian...). Công thức tính cước chi tiết là
        "open item" chưa được khách hàng chốt (xem B8).
      parameters:
        - $ref: '#/components/parameters/TripId'
      responses:
        '200':
          description: Thông tin cước phí
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Fare'
        '404':
          $ref: '#/components/responses/NotFound'

  /trips/{tripId}/payment-method:
    patch:
      tags: [Payments]
      summary: Khách hàng chọn phương thức thanh toán cho chuyến đi
      x-functional-requirement: FR16
      parameters:
        - $ref: '#/components/parameters/TripId'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                method:
                  $ref: '#/components/schemas/PaymentMethod'
              required: [method]
      responses:
        '200':
          description: Phương thức thanh toán đã được ghi nhận
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Payment'
        '404':
          $ref: '#/components/responses/NotFound'

  /trips/{tripId}/payments:
    post:
      tags: [Payments]
      summary: Khởi tạo/xử lý giao dịch thanh toán cho chuyến đi
      x-functional-requirement: FR17
      description: >
        Đối với thanh toán điện tử, hệ thống gọi API của cổng thanh toán bên
        thứ ba. Hệ thống CAB không lưu trực tiếp thông tin thẻ/tài khoản
        thanh toán nhạy cảm (BRL04) - chỉ lưu `externalTransactionRef`.
      parameters:
        - $ref: '#/components/parameters/TripId'
      responses:
        '200':
          description: Kết quả giao dịch thanh toán
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Payment'
        '402':
          description: Giao dịch thanh toán điện tử thất bại
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
        '404':
          $ref: '#/components/responses/NotFound'

  /trips/{tripId}/payments/retry:
    post:
      tags: [Payments]
      summary: Thử lại giao dịch thanh toán điện tử sau khi thất bại
      x-functional-requirement: FR18
      description: >
        Cho phép khách hàng thử lại thanh toán theo chính sách retry của
        doanh nghiệp (chi tiết chính sách retry là "open item" - xem B8).
      parameters:
        - $ref: '#/components/parameters/TripId'
      responses:
        '200':
          description: Kết quả thử lại giao dịch
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Payment'
        '402':
          description: Giao dịch tiếp tục thất bại
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
        '404':
          $ref: '#/components/responses/NotFound'

  # ===================== FR19 - FR20: NOTIFICATIONS =====================
  /notifications:
    get:
      tags: [Notifications]
      summary: Lấy danh sách thông báo của khách hàng hoặc tài xế
      x-functional-requirement: FR19,FR20
      description: >
        Dùng chung cho cả khách hàng (FR19: tiếp nhận yêu cầu, tài xế nhận
        chuyến, đến điểm đón, hoàn thành, kết quả thanh toán) và tài xế
        (FR20: chuyến mới, thay đổi liên quan chuyến đang thực hiện), phân
        biệt qua `recipientType`.
      parameters:
        - name: recipientId
          in: query
          required: true
          schema:
            type: string
        - name: recipientType
          in: query
          required: true
          schema:
            type: string
            enum: [customer, driver]
      responses:
        '200':
          description: Danh sách thông báo
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Notification'

  # ===================== FR21 - FR24: ADMIN =====================
  /admin/trips:
    get:
      tags: [Admin]
      summary: Nhân viên vận hành xem các chuyến đang diễn ra
      x-functional-requirement: FR21
      security:
        - bearerAuth: []
      parameters:
        - name: status
          in: query
          schema:
            type: string
            enum: [searching, driver_assigned, in_progress, completed, cancelled, no_driver_found]
      responses:
        '200':
          description: Danh sách chuyến đi
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/TripStatus'

  /admin/drivers:
    get:
      tags: [Admin]
      summary: Nhân viên vận hành xem trạng thái tài xế
      x-functional-requirement: FR21
      security:
        - bearerAuth: []
      parameters:
        - name: status
          in: query
          schema:
            $ref: '#/components/schemas/DriverStatus'
      responses:
        '200':
          description: Danh sách tài xế
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Driver'

  /admin/trips/{tripId}/incidents:
    post:
      tags: [Admin]
      summary: Nhân viên vận hành xử lý chuyến gặp sự cố
      x-functional-requirement: FR22
      security:
        - bearerAuth: []
      parameters:
        - $ref: '#/components/parameters/TripId'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                operatorId:
                  type: string
                issueType:
                  type: string
                  example: "driver_unreachable"
                note:
                  type: string
              required: [operatorId, issueType]
      responses:
        '201':
          description: Sự cố đã được ghi nhận và xử lý
          content:
            application/json:
              schema:
                type: object
                properties:
                  incidentId:
                    type: string
                  tripId:
                    type: string
                  status:
                    type: string
                    example: "resolved"

  /admin/trips/history:
    get:
      tags: [Admin]
      summary: Nhân viên vận hành tra cứu lịch sử chuyến đi/giao dịch
      x-functional-requirement: FR23
      security:
        - bearerAuth: []
      parameters:
        - name: fromDate
          in: query
          schema:
            type: string
            format: date
        - name: toDate
          in: query
          schema:
            type: string
            format: date
        - name: customerId
          in: query
          schema:
            type: string
        - name: driverId
          in: query
          schema:
            type: string
      responses:
        '200':
          description: Danh sách lịch sử chuyến đi/giao dịch phù hợp bộ lọc
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/TripStatus'

  /admin/staff/{staffId}/roles:
    get:
      tags: [Admin]
      summary: Xem quyền/vai trò của một nhân viên vận hành
      x-functional-requirement: FR24
      security:
        - bearerAuth: []
      parameters:
        - name: staffId
          in: path
          required: true
          schema:
            type: string
      responses:
        '200':
          description: Danh sách vai trò/quyền của nhân viên
          content:
            application/json:
              schema:
                type: object
                properties:
                  staffId:
                    type: string
                  roles:
                    type: array
                    items:
                      type: string
                      example: "operator_basic"
                  permissions:
                    type: array
                    items:
                      type: string
                      example: "trip.view"

  # ===================== FR25: REPORTS =====================
  /admin/reports:
    get:
      tags: [Reports]
      summary: Xuất báo cáo thống kê
      x-functional-requirement: FR25
      description: >
        Báo cáo về số lượng chuyến, doanh thu, tỷ lệ hoàn thành/hủy, hiệu quả
        hoạt động của tài xế trong một khoảng thời gian.
      security:
        - bearerAuth: []
      parameters:
        - name: fromDate
          in: query
          required: true
          schema:
            type: string
            format: date
        - name: toDate
          in: query
          required: true
          schema:
            type: string
            format: date
      responses:
        '200':
          description: Dữ liệu báo cáo thống kê
          content:
            application/json:
              schema:
                type: object
                properties:
                  totalTrips:
                    type: integer
                  totalRevenue:
                    type: number
                    format: double
                  completionRate:
                    type: number
                    format: float
                    example: 0.94
                  cancellationRate:
                    type: number
                    format: float
                    example: 0.06
                  driverPerformance:
                    type: array
                    items:
                      type: object
                      properties:
                        driverId:
                          type: string
                        completedTrips:
                          type: integer
                        avgRating:
                          type: number
                          format: float

  # ===================== FR26 - FR27: CUSTOMERS =====================
  /customers/{customerId}/trips:
    get:
      tags: [Customers]
      summary: Khách hàng xem lịch sử chuyến đi và thanh toán
      x-functional-requirement: FR26
      parameters:
        - name: customerId
          in: path
          required: true
          schema:
            type: string
      responses:
        '200':
          description: Lịch sử chuyến đi kèm thông tin thanh toán
          content:
            application/json:
              schema:
                type: array
                items:
                  type: object
                  properties:
                    trip:
                      $ref: '#/components/schemas/TripStatus'
                    payment:
                      $ref: '#/components/schemas/Payment'

  /trips/{tripId}/rating:
    post:
      tags: [Customers]
      summary: Khách hàng đánh giá tài xế sau chuyến
      x-functional-requirement: FR27
      parameters:
        - $ref: '#/components/parameters/TripId'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                score:
                  type: integer
                  minimum: 1
                  maximum: 5
                comment:
                  type: string
              required: [score]
      responses:
        '201':
          description: Đánh giá đã được ghi nhận
          content:
            application/json:
              schema:
                type: object
                properties:
                  ratingId:
                    type: string
                  tripId:
                    type: string
                  score:
                    type: integer
                  comment:
                    type: string
        '404':
          $ref: '#/components/responses/NotFound'

  # ===================== FR28: AUTH =====================
  /auth/register:
    post:
      tags: [Auth]
      summary: Đăng ký tài khoản (khách hàng hoặc tài xế)
      x-functional-requirement: FR28
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                userType:
                  type: string
                  enum: [customer, driver]
                phone:
                  type: string
                password:
                  type: string
                  format: password
              required: [userType, phone, password]
      responses:
        '201':
          description: Tài khoản đã được tạo

  /auth/login:
    post:
      tags: [Auth]
      summary: Xác thực khách hàng/tài xế
      x-functional-requirement: FR28
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                phone:
                  type: string
                password:
                  type: string
                  format: password
              required: [phone, password]
      responses:
        '200':
          description: Đăng nhập thành công, trả về access token
          content:
            application/json:
              schema:
                type: object
                properties:
                  accessToken:
                    type: string
                  expiresIn:
                    type: integer
                    example: 3600
        '401':
          description: Sai thông tin đăng nhập
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

  # ===================== FR29: AUDIT =====================
  /admin/audit-logs:
    get:
      tags: [Audit]
      summary: Truy vấn nhật ký thao tác (audit trail)
      x-functional-requirement: FR29
      description: >
        Ghi lại và cho phép tra cứu các thao tác quan trọng (thanh toán,
        phân quyền, chỉnh sửa hồ sơ tài xế...) phục vụ kiểm tra khi có sự cố.
      security:
        - bearerAuth: []
      parameters:
        - name: fromDate
          in: query
          schema:
            type: string
            format: date
        - name: toDate
          in: query
          schema:
            type: string
            format: date
        - name: actorId
          in: query
          schema:
            type: string
      responses:
        '200':
          description: Danh sách bản ghi audit log
          content:
            application/json:
              schema:
                type: array
                items:
                  type: object
                  properties:
                    logId:
                      type: string
                    actorId:
                      type: string
                    actorType:
                      type: string
                      enum: [operator, system]
                    action:
                      type: string
                      example: "payment.refund"
                    performedAt:
                      type: string
                      format: date-time

components:
  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT

  parameters:
    TripId:
      name: tripId
      in: path
      required: true
      schema:
        type: string
        example: "trip_123"
    OfferId:
      name: offerId
      in: path
      required: true
      schema:
        type: string
        example: "off_001"
    DriverId:
      name: driverId
      in: path
      required: true
      schema:
        type: string
        example: "drv_001"

  responses:
    NotFound:
      description: Không tìm thấy tài nguyên
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/Error'
    BadRequest:
      description: Yêu cầu không hợp lệ
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/Error'

  schemas:
    Error:
      type: object
      properties:
        code:
          type: string
          example: "RESOURCE_NOT_FOUND"
        message:
          type: string
          example: "Không tìm thấy tài nguyên yêu cầu."

    GeoLocation:
      type: object
      properties:
        latitude:
          type: number
          format: double
          example: 10.7769
        longitude:
          type: number
          format: double
          example: 106.7009
        recordedAt:
          type: string
          format: date-time

    DriverOfferStatus:
      type: string
      enum: [pending, accepted, rejected, timeout]

    DriverOffer:
      type: object
      properties:
        offerId:
          type: string
        tripId:
          type: string
        driverId:
          type: string
        status:
          $ref: '#/components/schemas/DriverOfferStatus'
        offeredAt:
          type: string
          format: date-time
        respondedAt:
          type: string
          format: date-time
          nullable: true

    DriverOfferResponseRequest:
      type: object
      properties:
        driverId:
          type: string
        decision:
          type: string
          enum: [accept, reject]
      required: [driverId, decision]

    DriverOfferResponseResult:
      type: object
      properties:
        offerId:
          type: string
        status:
          $ref: '#/components/schemas/DriverOfferStatus'
        nextOffer:
          type: object
          nullable: true
          properties:
            offerId:
              type: string
            driverId:
              type: string
            offeredAt:
              type: string
              format: date-time
        tripStatus:
          type: string
          enum: [searching, driver_assigned, no_driver_found]

    TripStatus:
      type: object
      properties:
        tripId:
          type: string
        customerId:
          type: string
        driverId:
          type: string
          nullable: true
        status:
          type: string
          enum:
            - requested
            - searching
            - driver_assigned
            - arrived_at_pickup
            - picked_up
            - in_progress
            - completed
            - cancelled
            - no_driver_found
        pickupLocation:
          type: string
        dropoffLocation:
          type: string
        updatedAt:
          type: string
          format: date-time

    DriverStatus:
      type: string
      enum: [available, busy, offline]

    Driver:
      type: object
      properties:
        driverId:
          type: string
        fullName:
          type: string
        phone:
          type: string
        status:
          $ref: '#/components/schemas/DriverStatus'
        createdBy:
          type: string
          enum: [self, operator]

    DriverCreateRequest:
      type: object
      properties:
        fullName:
          type: string
        phone:
          type: string
        createdBy:
          type: string
          enum: [self, operator]
      required: [fullName, phone, createdBy]

    DriverProfileUpdateRequest:
      type: object
      properties:
        fullName:
          type: string
        phone:
          type: string
        email:
          type: string
          format: email

    Vehicle:
      type: object
      properties:
        vehicleId:
          type: string
        driverId:
          type: string
        plateNumber:
          type: string
        vehicleType:
          type: string
          example: "4-seat"

    PaymentMethod:
      type: string
      enum: [cash, electronic]

    Payment:
      type: object
      properties:
        paymentId:
          type: string
        tripId:
          type: string
        amount:
          type: number
          format: double
        method:
          $ref: '#/components/schemas/PaymentMethod'
        status:
          type: string
          enum: [pending, success, failed]
        externalTransactionRef:
          type: string
          nullable: true
          description: Tham chiếu giao dịch từ cổng thanh toán ngoài (BRL04 - không lưu dữ liệu thẻ nhạy cảm)

    Fare:
      type: object
      properties:
        tripId:
          type: string
        amount:
          type: number
          format: double
        currency:
          type: string
          example: "VND"
        breakdown:
          type: object
          description: Chi tiết cách tính (công thức cụ thể là open item - xem B8)
          additionalProperties: true

    Notification:
      type: object
      properties:
        notificationId:
          type: string
        recipientId:
          type: string
        recipientType:
          type: string
          enum: [customer, driver]
        eventType:
          type: string
          example: "trip.driver_assigned"
        message:
          type: string
        sentAt:
          type: string
          format: date-time
